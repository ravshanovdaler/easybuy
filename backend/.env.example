# EasyBuy Environment Variables
# Copy this file to .env and fill in your values

# === TELEGRAM ===
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_SECRET=your_random_secret_here

# === JWT ===
JWT_SECRET=your_very_long_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === ADMIN ===
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change_me_strong_password

# === DATABASE (SQLite for PythonAnywhere free tier) ===
DATABASE_URL=sqlite:///./easybuy.db

# === STORAGE (local filesystem) ===
UPLOAD_DIR=uploads
BASE_URL=https://yourusername.pythonanywhere.com

# === APP SETTINGS ===
APP_NAME=EasyBuy
SECRET_KEY=another_random_secret_for_sessions
ENVIRONMENT=production
